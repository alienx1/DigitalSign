# Copy to .env for local development. See SCOPE.md for the policy behind these.

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8080

# --- /ds JSON body limit in bytes (default 25MB if unset). document_base64 +
# per-signature p12/image_base64 all live in one JSON body, so this needs to
# comfortably exceed the largest real PDF you expect, post-base64 inflation. ---
MAX_JSON_BODY_BYTES=26214400

# --- Logging (read by tracing-subscriber's EnvFilter) ---
RUST_LOG=info

# --- Auth (required by the /ds ApiKeyAuth middleware, X-API-Key header) ---
API_KEY=changeme-dev-key


# --- Root CA that issues every generated signer certificate (see SCOPE.md
# "Root CA / cert trust"). ROOT_CA_KEY_PATH points at any PEM EC/RSA private
# key; a fresh self-signed CA cert is built from it at startup using
# ROOT_CA_CN. Both are plain config, never hardcoded in source, so the key
# or identity behind the root can always be swapped without a code change. ---
ROOT_CA_KEY_PATH=path_ca_key/ca.key
ROOT_CA_CN="domain.ca Document Signing CA"
ROOT_CA_VALIDITY_DAYS=3650

# --- RFC 3161 timestamping (PAdES-B-T). TSA_ENABLED=false (or unset) means
# PAdES-B-B, unchanged from before — TSA_URL stays here either way, so
# flipping TSA_ENABLED back to true later doesn't mean re-typing the URL.
# Flip it, or change TSA_URL, any time — no code change needed. A
# misbehaving/unreachable TSA fails the whole /ds/sign request rather than
# silently signing without a timestamp. Verified working against:
# https://freetsa.org/tsr (recommended — publishes its own CA chain publicly,
# no signup), http://timestamp.digicert.com, http://timestamp.sectigo.com,
# http://timestamp.globalsign.com/tsa/r6advanced1, http://timestamp.apple.com/ts01,
# http://time.certum.pl. ---
TSA_ENABLED=false
TSA_URL=https://freetsa.org/tsr
TSA_TIMEOUT_SECS=10
